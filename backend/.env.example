PORT=5000
# Optional local LLM through Ollama. It needs no API key.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_OLLAMA=true
# Optional MySQL database. Leave unset to use backend/data/plans.json.
# MYSQL_URL=mysql://username:password@host:3306/database
# MYSQL_URL=mysql://username:password@host:3306/database
